APP_MODE=all
NODE_ENV=development
PORT=3000
# Public base URL of this API, used in page image links the frontend stores
API_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (the frontend)
CORS_ORIGINS=http://localhost:3000
# Rate limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL ms
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Database + Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flyers
DB_USERNAME=flyers
DB_PASSWORD=flyers
# DATABASE_URL=postgres://user:pass@host:5432/db
# TypeORM schema sync: on in dev; in production only for the first deploy, then remove
DB_SYNCHRONIZE=true

# Admin API keys: comma-separated sha256 hex of each key (unset = admin routes reject everything)
# ADMIN_API_KEY_HASHES=

# Cloudflare R2 (token needs object read/write + bucket lifecycle config)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PAGE_TTL_DAYS=14

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Worker
PIPELINE_CRON=0 6 * * *
PIPELINE_RETRY_CRON=*/15 * * * *
# PIPELINE_TMP_DIR=
